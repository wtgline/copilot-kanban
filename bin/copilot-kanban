#!/usr/bin/env python3
"""copilot-kanban — a browser Kanban board for GitHub Copilot CLI sessions.

Shows every Copilot CLI session running in your tmux setup as a draggable
card: what it was asked to do, whether it's busy or free, and which pane it
lives in. Drag a Backlog card into "Working" to spawn a real agent; assign a
follow-up task to a free session to continue its conversation.

Requires macOS, tmux, and GitHub Copilot CLI. Zero Python dependencies —
standard library only.

    copilot-kanban                 # serve on http://127.0.0.1:47900 and open a browser
    copilot-kanban --port 8080     # use a different port
    copilot-kanban --no-open       # don't open a browser
    copilot-kanban --tmux mygrid   # target a specific tmux session
    copilot-kanban --version

Environment overrides: COPILOT_KANBAN_PORT, COPILOT_KANBAN_TMUX
"""
import os, sys, json, glob, time, uuid, shlex, fcntl, secrets, subprocess, webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from datetime import datetime, timezone

__version__ = "0.1.0"

# Regenerated every launch and embedded in the page we serve. Mutating API
# calls must echo it back, so a page we did not serve cannot drive the board.
SESSION_TOKEN = secrets.token_urlsafe(24)

HOME = os.path.expanduser("~")
COPILOT_HOME = os.environ.get("COPILOT_HOME") or os.path.join(HOME, ".copilot")
ROOT = os.path.join(COPILOT_HOME, "session-state")
HOOK_STATUS = os.path.join(COPILOT_HOME, "board-status.json")
KANBAN_STATE = os.path.join(COPILOT_HOME, "kanban-state.json")
DEFAULT_PORT = 47900

COLUMNS = ["backlog", "working", "available", "archived"]
FINISHED_LABEL_WINDOW = 24 * 3600   # how long the "✓ finished ..." badge shows at all
RECENT_HIGHLIGHT_WINDOW = 60 * 60   # seconds a tile gets the "recent" glow highlight
LABEL_GRANULARITY = 30 * 60         # coarsest useful resolution: half an hour
ARCHIVED_LIMIT = 15                 # how many past sessions to keep on the board

# Agents dispatched from the board run with --yolo (all tool calls
# auto-approved) unless this is turned off, because a backgrounded agent that
# stops to ask permission just blocks forever with nobody watching. Set
# COPILOT_KANBAN_AUTO_APPROVE=0 to require approval in the pane instead.
AUTO_APPROVE = os.environ.get("COPILOT_KANBAN_AUTO_APPROVE", "1") != "0"

# Terminal apps we know how to bring to the front when jumping to a pane.
# tmux selection still works in any terminal; only this raise step is limited.
TERMINAL_APPS = [a for a in (os.environ.get("COPILOT_KANBAN_TERMINALS") or "").split(",") if a] or [
    "iTerm2", "Terminal", "Ghostty", "Alacritty", "WezTerm", "kitty", "Warp", "Hyper",
]

# Changes whenever this file changes, so an open browser tab running older
# JS can detect a restart and reload itself instead of misrendering new data.
try:
    SERVER_VERSION = str(int(os.path.getmtime(os.path.abspath(__file__))))
except OSError:
    SERVER_VERSION = "0"


# ----------------------------------------------------------------- utilities
def yaml_lite(path):
    d = {}
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                if ":" in line and not line.lstrip().startswith("#"):
                    k, _, v = line.partition(":")
                    d[k.strip()] = v.strip()
    except OSError:
        pass
    return d


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError):
        return False


def valid_session_id(sid):
    """Session ids become path segments, so keep them to a safe alphabet.

    Copilot writes UUID-named directories; anything with a separator or a
    parent reference in it is either a bug or an attempt at traversal.
    """
    if not sid or len(sid) > 128:
        return False
    if "/" in sid or "\\" in sid or sid.startswith("."):
        return False
    return all(ch.isalnum() or ch in "-_" for ch in sid)


def read_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def _update_json_locked(path, mutate):
    """Read-modify-write a JSON file while holding an exclusive lock.

    Opening with "w" would truncate the file *before* the lock is taken, so a
    concurrent reader could see an empty file and a concurrent writer could
    lose the update entirely. Several processes touch these files at once —
    this server is threaded, and every Copilot pane runs the hook — so all
    writes go through here.
    """
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a+", encoding="utf-8") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            f.seek(0)
            try:
                data = json.loads(f.read() or "{}")
            except ValueError:
                data = {}
            if not isinstance(data, dict):
                data = {}
            result = mutate(data)
            f.seek(0)
            f.truncate()
            json.dump(data, f, indent=1)
            f.flush()
            return result
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def write_state(data):
    """Replace the board's own state file, atomically with respect to peers."""
    def mutate(existing):
        existing.clear()
        existing.update(data)
    _update_json_locked(KANBAN_STATE, mutate)


def update_hook_status(session_id, **fields):
    """Merge fields into board-status.json without clobbering the hooks.

    The hook handler writes this file from every Copilot pane. A plain
    overwrite here would race with it and could wipe other sessions' state.
    """
    def mutate(data):
        data.setdefault(session_id, {}).update(fields)
    _update_json_locked(HOOK_STATUS, mutate)


def load_state():
    s = read_json(KANBAN_STATE, {})
    if not isinstance(s, dict):
        s = {}
    s.setdefault("cards", {})       # user-created backlog cards
    s.setdefault("overrides", {})   # session_id -> {"column": ...}
    return s


def tmux_run(*args):
    """Run tmux and hand back the CompletedProcess so callers can check it."""
    try:
        return subprocess.run(["tmux", *args], capture_output=True,
                              text=True, timeout=10)
    except Exception:
        return None


def tmux(*args, capture=True):
    try:
        r = subprocess.run(["tmux", *args], capture_output=capture,
                           text=True, timeout=5)
        return r.stdout if capture else ""
    except FileNotFoundError:
        return ""
    except Exception:
        return ""


def tmux_available():
    """True if the tmux binary exists and a server is running."""
    try:
        r = subprocess.run(["tmux", "ls"], capture_output=True, timeout=5)
        return r.returncode == 0
    except Exception:
        return False


def resolve_tmux_session():
    """Pick which tmux session to dispatch new work into.

    Explicit configuration always wins. Otherwise prefer the session this
    process is attached to, then a session that already hosts Copilot panes,
    then the only session if there is exactly one. Returns None when we
    genuinely cannot tell, so callers can show a clear message instead of
    silently targeting the wrong session.
    """
    configured = os.environ.get("COPILOT_KANBAN_TMUX")
    if configured:
        return configured

    sessions = [s for s in tmux("ls", "-F", "#{session_name}").splitlines() if s.strip()]
    if not sessions:
        return None

    # If we're running inside tmux, use the session we're in.
    current = tmux("display-message", "-p", "#{session_name}").strip()
    if current and current in sessions:
        return current

    # Otherwise prefer whichever session already has copilot panes in it.
    hosting = set()
    raw = tmux("list-panes", "-a", "-F",
               "#{session_name}\t#{pane_current_command}")
    for line in raw.splitlines():
        parts = line.split("\t")
        if len(parts) == 2 and "copilot" in parts[1].lower():
            hosting.add(parts[0])
    if len(hosting) == 1:
        return hosting.pop()

    if len(sessions) == 1:
        return sessions[0]
    return None


def tmux_panes():
    """pane_pid -> (session:window, pane_index, pane_id, label)"""
    out = {}
    raw = tmux("list-panes", "-a", "-F",
               "#{pane_pid}\t#{session_name}:#{window_name}\t#{pane_index}\t#{pane_id}\t#{@label}")
    for line in raw.splitlines():
        p = line.split("\t")
        if len(p) >= 4:
            out[p[0]] = (p[1], p[2], p[3], p[4] if len(p) > 4 else "")
    return out


def process_tree():
    tree = {}
    try:
        r = subprocess.run(["ps", "-eo", "pid=,ppid="], capture_output=True,
                           text=True, timeout=5)
    except Exception:
        return tree
    for line in r.stdout.splitlines():
        try:
            pid, ppid = line.split()
        except ValueError:
            continue
        tree.setdefault(ppid, []).append(pid)
    return tree


def resolve_pane(pid, panes, tree):
    if not pid:
        return None
    if pid in panes:
        return panes[pid]
    for pane_pid in panes:
        stack, seen = [pane_pid], set()
        while stack:
            cur = stack.pop()
            if cur in seen:
                continue
            seen.add(cur)
            if cur == pid:
                return panes[pane_pid]
            stack.extend(tree.get(cur, []))
    return None


def age(ts):
    try:
        t = datetime.fromisoformat(ts.replace("Z", "+00:00"))
        secs = (datetime.now(timezone.utc) - t).total_seconds()
    except Exception:
        return ""
    if secs < 60:
        return f"{int(secs)}s"
    if secs < 3600:
        return f"{int(secs // 60)}m"
    if secs < 86400:
        return f"{int(secs // 3600)}h"
    return f"{int(secs // 86400)}d"


def finished_label(elapsed):
    """Coarse 'finished X ago' text, floored to half-hour steps.

    The board re-polls every couple of seconds, so a second-precise counter
    would visibly tick on every refresh for no benefit. Half an hour is the
    finest resolution that stays useful, so the label only changes twice an
    hour and otherwise sits still.
    """
    if elapsed < LABEL_GRANULARITY:
        return "just now"
    half_hours = int(elapsed // LABEL_GRANULARITY)
    hours, rem = divmod(half_hours, 2)
    if hours == 0:
        return "30m ago"
    if hours >= 24:
        days = hours // 24
        return f"{days}d ago"
    return f"{hours}h 30m ago" if rem else f"{hours}h ago"


def last_assistant_text(session_id, limit=400):
    """Tail events.jsonl for the most recent assistant message."""
    path = os.path.join(ROOT, session_id, "events.jsonl")
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as f:
            f.seek(max(0, size - 262144))
            chunk = f.read().decode("utf-8", "ignore")
    except OSError:
        return ""
    best = ""
    for line in chunk.splitlines():
        if '"assistant' not in line:
            continue
        try:
            d = json.loads(line)
        except Exception:
            continue
        data = d.get("data") or {}
        txt = data.get("content") or data.get("text") or ""
        if d.get("type") == "assistant.message" and isinstance(txt, str) and txt.strip():
            best = txt
    return best.strip()[:limit]


import re as _re

_MD_CODE = _re.compile(r"```.*?```", _re.S)
_MD_INLINE_CODE = _re.compile(r"`([^`]+)`")
# Only asterisk emphasis is stripped. Underscores are left alone so
# identifiers like __init__ or snake_case survive intact.
_MD_BOLD_ITALIC = _re.compile(r"(?<![\w*])(\*{1,3})(?!\s)([^*\n]+?)(?<!\s)\1(?![\w*])")
_MD_HEADER = _re.compile(r"^\#{1,6}\s*", _re.M)
_MD_LINK = _re.compile(r"\[([^\]]+)\]\([^)]+\)")
_WS = _re.compile(r"\s+")


def summarize(text, max_len=180):
    """Heuristic one-line summary of an assistant reply: strip markdown noise,
    collapse code blocks, keep the gist short instead of the full detail."""
    if not text:
        return ""
    t = _MD_CODE.sub(" [code] ", text)
    t = _MD_HEADER.sub("", t)
    t = _MD_LINK.sub(r"\1", t)
    t = _MD_INLINE_CODE.sub(r"\1", t)
    t = _MD_BOLD_ITALIC.sub(r"\2", t)
    t = _WS.sub(" ", t).strip()
    if len(t) <= max_len:
        return t
    cut = t[:max_len]
    # prefer cutting at a sentence or word boundary rather than mid-word
    for sep in (". ", "! ", "? "):
        idx = cut.rfind(sep)
        if idx > max_len * 0.4:
            return cut[:idx + 1].strip()
    idx = cut.rfind(" ")
    return (cut[:idx] if idx > 0 else cut).strip() + "…"


def _html_escape(s):
    return (s.replace("&", "&amp;").replace("<", "&lt;")
             .replace(">", "&gt;").replace('"', "&quot;"))


_INLINE_CODE = _re.compile(r"`([^`\n]+)`")
_BOLD = _re.compile(r"\*\*([^*\n]+)\*\*")
_ITALIC = _re.compile(r"(?<!\*)\*([^*\n]+)\*(?!\*)")
_LINK = _re.compile(r"\[([^\]]+)\]\(([^)\s]+)\)")

# Agent replies can quote text the agent read off a web page, so treat link
# targets as untrusted. Only these schemes may end up in an href; anything
# else (javascript:, data:, vbscript:, ...) renders as plain text.
_SAFE_URL_SCHEMES = ("http://", "https://", "mailto:")


def _safe_url(url):
    """Return the url if it is safe to put in an href, else None."""
    # &quot; etc. are already escaped by the time we see this; unescape the
    # ampersand so scheme checks aren't fooled by encoding tricks.
    probe = url.replace("&amp;", "&").strip().lower()
    # Strip characters browsers ignore when parsing a scheme.
    probe = "".join(ch for ch in probe if ch not in "\t\r\n \x00")
    if probe.startswith(("#", "/")):
        return url
    if probe.startswith(_SAFE_URL_SCHEMES):
        return url
    return None


def _link_sub(m):
    text, url = m.group(1), m.group(2)
    safe = _safe_url(url)
    if safe is None:
        # Show what it claimed to link to rather than silently dropping it.
        return f"{text} ({url})"
    return f'<a href="{safe}" target="_blank" rel="noopener noreferrer">{text}</a>'


def _inline_md(s):
    s = _html_escape(s)
    s = _INLINE_CODE.sub(r"<code>\1</code>", s)
    s = _LINK.sub(_link_sub, s)
    s = _BOLD.sub(r"<strong>\1</strong>", s)
    s = _ITALIC.sub(r"<em>\1</em>", s)
    return s


def markdown_to_html(text):
    """Minimal, dependency-free markdown renderer: headers, bold/italic,
    inline + fenced code, links, and both bullet and numbered lists. Escapes
    all raw HTML first so it's safe to render with innerHTML client-side."""
    if not text:
        return ""
    lines = text.replace("\r\n", "\n").split("\n")
    out, i, n = [], 0, len(lines)
    in_ul = in_ol = False

    def close_lists():
        nonlocal in_ul, in_ol
        if in_ul:
            out.append("</ul>")
            in_ul = False
        if in_ol:
            out.append("</ol>")
            in_ol = False

    while i < n:
        line = lines[i]
        if line.strip().startswith("```"):
            close_lists()
            i += 1
            code = []
            while i < n and not lines[i].strip().startswith("```"):
                code.append(lines[i])
                i += 1
            i += 1
            # An unclosed fence renders the remainder as code, which is both
            # what markdown does and the sane result when the source has been
            # truncated mid-block.
            out.append(f"<pre><code>{_html_escape(chr(10).join(code))}</code></pre>")
            continue
        m = _re.match(r"^(#{1,6})\s+(.*)", line)
        if m:
            close_lists()
            lvl = len(m.group(1))
            out.append(f"<h{lvl}>{_inline_md(m.group(2))}</h{lvl}>")
            i += 1
            continue
        m = _re.match(r"^\s*[-*]\s+(.*)", line)
        if m:
            if in_ol:
                out.append("</ol>")
                in_ol = False
            if not in_ul:
                out.append("<ul>")
                in_ul = True
            out.append(f"<li>{_inline_md(m.group(1))}</li>")
            i += 1
            continue
        m = _re.match(r"^\s*\d+\.\s+(.*)", line)
        if m:
            if in_ul:
                out.append("</ul>")
                in_ul = False
            if not in_ol:
                out.append("<ol>")
                in_ol = True
            out.append(f"<li>{_inline_md(m.group(1))}</li>")
            i += 1
            continue
        if not line.strip():
            close_lists()
            i += 1
            continue
        close_lists()
        out.append(f"<p>{_inline_md(line.strip())}</p>")
        i += 1
    close_lists()
    return "\n".join(out)


# ------------------------------------------------------------------ the board
def collect():
    hook = read_json(HOOK_STATUS, {})
    state = load_state()
    panes, tree = tmux_panes(), process_tree()
    cards = []

    # --- live + historical Copilot sessions -------------------------------
    rows = []
    for d in sorted(glob.glob(os.path.join(ROOT, "*"))):
        if not os.path.isdir(d):
            continue
        sid = os.path.basename(d)
        ws = yaml_lite(os.path.join(d, "workspace.yaml"))
        if not ws:
            continue
        live_pid = None
        for lk in glob.glob(os.path.join(d, "inuse.*.lock")):
            p = os.path.basename(lk).split(".")[1]
            if pid_alive(p):
                live_pid = p
                break
        rows.append((sid, ws, live_pid, hook.get(sid, {})))

    # A tmux pane may own several session dirs (a scratch one plus the resumed
    # one). Keep the most informative per live PID; the others still deserve a
    # card, just as history rather than as a second live session.
    best, loose = {}, []
    for sid, ws, pid, note in rows:
        if not pid:
            loose.append((sid, ws, None, note))
            continue
        rank = (bool(ws.get("name")), ws.get("updated_at", ""))
        prev = best.get(pid)
        if prev is None:
            best[pid] = (rank, (sid, ws, pid, note))
        elif rank > prev[0]:
            best[pid] = (rank, (sid, ws, pid, note))
            psid, pws, _, pnote = prev[1]
            loose.append((psid, pws, None, pnote))
        else:
            loose.append((sid, ws, None, note))
    merged = [v[1] for v in best.values()] + loose

    for sid, ws, pid, note in merged:
        hook_state = note.get("state")
        finished_txt = None
        recent = False
        stopped_at_val = None
        raw_stopped_at = note.get("stopped_at")
        if raw_stopped_at:
            try:
                stopped_at_val = float(raw_stopped_at)
            except (TypeError, ValueError):
                stopped_at_val = None

        loc = resolve_pane(pid, panes, tree)
        # A live PID alone isn't proof the session is alive: if a session was
        # killed and the OS later recycled its PID, the lock file would still
        # point at a running-but-unrelated process. Requiring that the PID
        # also live inside a known tmux pane rules that out.
        if pid and not loc:
            pid = None

        if pid:
            if hook_state == "running":
                col = "working"
            else:
                # Everything not actively running is simply "available" —
                # there is no lasting distinction between "just finished" and
                # "has been idle a while": every available session has SOME
                # prior output, so a permanent Done/Idle split just
                # accumulates stale cards. Recency is shown as a coarse
                # badge plus a temporary highlight on the tile instead of a
                # separate column.
                col = "available"
                if hook_state == "stopped" and stopped_at_val:
                    elapsed = time.time() - stopped_at_val
                    if elapsed < FINISHED_LABEL_WINDOW:
                        finished_txt = finished_label(elapsed)
                    if elapsed < RECENT_HIGHLIGHT_WINDOW:
                        recent = True
        else:
            # No live process for this session at all — nothing to jump to or
            # assign work to, so it can never be "available" no matter what
            # the last recorded hook state was (a dead scratch/test session
            # otherwise looked identical to a real live one).
            col = "archived"

        ov = state["overrides"].get(sid, {}).get("column")
        # An override may only archive or restore; it must never contradict a
        # session that is demonstrably running.
        if ov in ("archived", "available") and col != "working":
            if not (ov == "available" and not pid):
                col = ov

        cards.append(dict(
            id=sid, kind="session", column=col,
            title=ws.get("name") or note.get("last_msg", "")[:60] or "(unnamed session)",
            cwd=(ws.get("cwd") or "").replace(HOME, "~"),
            short=sid[:8], pid=pid,
            window=loc[0].split(":")[-1] if loc else None,
            pane=f"{loc[0].split(':')[-1]}.{loc[1]}" if loc else None,
            pane_id=loc[2] if loc else None,
            tmux_window=loc[0] if loc else None,
            label=loc[3] if loc else "",
            prompt=note.get("last_msg", ""),
            updated=ws.get("updated_at", ""),
            age=age(ws.get("updated_at", "")),
            just_finished=finished_txt,
            stopped_at=stopped_at_val,
            recent=recent,
        ))

    # --- user-created backlog cards ---------------------------------------
    for cid, c in state["cards"].items():
        if c.get("session_id"):
            continue  # already dispatched; it now shows as a session card
        cards.append(dict(
            id=cid, kind="task", column=c.get("column", "backlog"),
            title=c.get("title", "(untitled)"), cwd=c.get("dir", "~"),
            short="new", pid=None, window=c.get("window"), pane=None,
            pane_id=None, tmux_window=None, label="",
            prompt=c.get("prompt", ""), updated=c.get("created", ""),
            age=age(c.get("created", "")), just_finished=None,
            stopped_at=None, recent=False,
        ))

    order = {c: i for i, c in enumerate(COLUMNS)}
    # The archived column would otherwise show every session ever created.
    # Keep only the ones worth revisiting: named, most recent first.
    live = [c for c in cards if c["column"] != "archived"]
    arch = [c for c in cards if c["column"] == "archived"
            and c["title"] != "(unnamed session)"]
    arch.sort(key=lambda c: c["updated"], reverse=True)
    arch = arch[:ARCHIVED_LIMIT]

    live.sort(key=lambda c: (order.get(c["column"], 9), c["updated"]))

    # Within Available, show the most recently finished session first —
    # sessions with no recorded finish time (freshly resumed, no agentStop
    # yet) sort to the bottom rather than mixing in arbitrarily.
    avail = [c for c in live if c["column"] == "available"]
    avail.sort(key=lambda c: (c["stopped_at"] is None, -(c["stopped_at"] or 0)))
    out, seen_avail = [], False
    for c in live:
        if c["column"] == "available":
            if not seen_avail:
                out.extend(avail)
                seen_avail = True
        else:
            out.append(c)
    # Archived keeps its newest-first order rather than being re-sorted
    # ascending, which used to show the oldest of the kept batch at the top.
    return out + arch


def tmux_windows():
    session = resolve_tmux_session()
    if not session:
        return []
    raw = tmux("list-windows", "-t", session, "-F", "#{window_name}")
    return [w for w in raw.splitlines() if w.strip()]


# ------------------------------------------------------------------- actions
def dispatch(card_id):
    """Spawn a real Copilot agent in a new tmux window for a backlog card."""
    state = load_state()
    card = state["cards"].get(card_id)
    if not card:
        return False, "card not found"
    if not tmux_available():
        return False, "tmux is not running — start your tmux session first"

    session = resolve_tmux_session()
    if not session:
        return False, ("could not tell which tmux session to use; set "
                       "COPILOT_KANBAN_TMUX or start copilot-kanban with --tmux")
    if subprocess.run(["tmux", "has-session", "-t", session],
                      capture_output=True).returncode != 0:
        return False, f"tmux session '{session}' is not running"

    directory = os.path.expanduser(card.get("dir") or "~")
    if not os.path.isdir(directory):
        directory = HOME

    # Pre-assign the session UUID so the card binds to its session
    # deterministically instead of being matched up afterwards.
    sid = str(uuid.uuid4())
    prompt = card.get("prompt") or card.get("title") or ""
    # Run copilot as the window's own command rather than typing it into an
    # interactive shell: shell startup prompts (e.g. the oh-my-zsh update
    # question) otherwise swallow the first keystrokes. `exec $SHELL` keeps the
    # pane alive after the agent exits so output stays readable.
    shell = os.environ.get("SHELL", "/bin/zsh")
    flags = "--yolo " if AUTO_APPROVE else ""
    inner = (f"copilot {flags}--session-id {sid} -i {shlex.quote(prompt)}; "
             f"exec {shlex.quote(shell)}")

    # Create a dedicated window rather than splitting an existing one, so the
    # user's pane layout is never rearranged. -P -F prints the new pane id so
    # we can label exactly that pane instead of whichever one is current.
    wname = "".join(ch if ch.isalnum() or ch in "-_" else "-"
                    for ch in card.get("title", "task"))[:18] or "task"
    proc = tmux_run("new-window", "-t", session, "-n", wname, "-c", directory,
                    "-P", "-F", "#{pane_id}", inner)
    if proc is None or proc.returncode != 0:
        err = (proc.stderr.strip() if proc is not None and proc.stderr
               else "tmux new-window failed")
        return False, f"could not start agent: {err}"
    pane_id = (proc.stdout or "").strip()
    if pane_id:
        tmux("set-option", "-p", "-t", pane_id, "@label",
             card.get("title", "task")[:24])

    card["session_id"] = sid
    card["column"] = "working"
    state["cards"][card_id] = card
    write_state(state)
    # Seed hook state so the card reads as Working immediately rather than
    # waiting for the agent's first hook to fire.
    update_hook_status(sid, state="running", last_msg=prompt, cwd=directory)
    return True, f"started in {session}:{wname}"


def focus(card_id):
    """Select the card's pane in tmux and bring the terminal app forward."""
    cards = {c["id"]: c for c in collect()}
    c = cards.get(card_id)
    if not c or not c.get("pane_id"):
        return False, "no live tmux pane for this card"
    selected = tmux_run("select-window", "-t", c["tmux_window"])
    if selected is None or selected.returncode != 0:
        return False, "could not select that pane — has the session closed?"
    tmux_run("select-pane", "-t", c["pane_id"])
    tmux_run("switch-client", "-t", c["tmux_window"])

    # Bringing the terminal to the front is best-effort: we can only ask apps
    # we know about, and we can't tell which one is hosting tmux. Say so
    # rather than claiming a jump that didn't visibly happen.
    raised = False
    if sys.platform == "darwin":
        for app in TERMINAL_APPS:
            r = subprocess.run(
                ["osascript", "-e",
                 'on run argv\n tell application (item 1 of argv) to activate\nend run',
                 app],
                capture_output=True)
            if r.returncode == 0:
                raised = True
                break
    if raised:
        return True, f"jumped to {c['pane']}"
    return True, (f"selected {c['pane']} — switch to your terminal to see it")


def assign(card_id, prompt):
    """Send a follow-up prompt into an already-live session's pane, so the
    work continues in that same conversation rather than a fresh one."""
    if not isinstance(prompt, str) or not prompt.strip():
        return False, "prompt is empty"
    cards = {c["id"]: c for c in collect()}
    c = cards.get(card_id)
    if not c or not c.get("pane_id"):
        return False, "this card has no live tmux pane to send work to"
    if c["column"] == "working":
        return False, "session is still busy — wait until it is free"

    # A newline in the middle of the text would submit the prompt early and
    # leave the remainder to be interpreted as a separate input, so flatten
    # any line breaks into spaces first.
    text = " ".join(prompt.split())
    if len(text) > 4000:
        return False, "prompt is too long to type into a pane (4000 char limit)"

    pane_id = c["pane_id"]
    # -l sends the text literally (no key-name interpretation) and -- ends
    # option parsing, so a prompt starting with "-" can't look like a flag.
    sent = tmux_run("send-keys", "-t", pane_id, "-l", "--", text)
    if sent is None or sent.returncode != 0:
        err = sent.stderr.strip() if sent is not None and sent.stderr else "send-keys failed"
        return False, f"could not send to pane: {err}"
    # The TUI needs a moment to finish rendering the typed text before it will
    # accept the submit key; sending both in one call proved unreliable.
    time.sleep(0.15)
    tmux_run("send-keys", "-t", pane_id, "Enter")

    # Flip the card to Working right away instead of waiting for the agent's
    # own hook to fire on the next poll.
    if valid_session_id(card_id) and os.path.isdir(os.path.join(ROOT, card_id)):
        update_hook_status(card_id, state="running", last_msg=text[:120],
                           cwd=c.get("cwd", ""))
    return True, f"sent to {c['pane']}"


def move(card_id, column):
    if column not in COLUMNS:
        return False, f"unknown column '{column}'"
    state = load_state()

    # User-created task cards: dropping one into Working is what launches it.
    if card_id in state["cards"]:
        if column == "working" and not state["cards"][card_id].get("session_id"):
            return dispatch(card_id)
        state["cards"][card_id]["column"] = column
        write_state(state)
        return True, "moved"

    # Session cards reflect reality, so only allow moves that reality permits.
    # Marking a live session "working" by hand would make the board claim an
    # agent is running when nothing is, and it would then never clear.
    live = {c["id"]: c for c in collect()}.get(card_id)
    if live is None:
        return False, "card not found"
    if column in ("working", "backlog"):
        return False, ("a session's state is set by the agent itself — "
                       "you can only archive or restore it here")
    if live["column"] == "working":
        return False, "session is still running"

    if column == "available" and not live.get("pid"):
        return False, "that session is no longer running"

    state["overrides"].setdefault(card_id, {})["column"] = column
    write_state(state)
    return True, "archived" if column == "archived" else "moved"


def new_card(payload):
    state = load_state()
    cid = "task-" + uuid.uuid4().hex[:8]
    state["cards"][cid] = {
        "title": (payload.get("title") or "Untitled").strip(),
        "prompt": (payload.get("prompt") or "").strip(),
        "dir": (payload.get("dir") or "~").strip(),
        "window": (payload.get("window") or "").strip() or None,
        "column": "backlog",
        "created": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "session_id": None,
    }
    write_state(state)
    return True, cid


def delete_card(card_id):
    """Remove a card from the board.

    Task cards are ours to delete outright. Session cards are derived from
    Copilot's own state on disk, so 'deleting' one can only mean hiding it —
    otherwise it simply reappears on the next poll.
    """
    state = load_state()
    if card_id in state["cards"]:
        state["cards"].pop(card_id, None)
        state["overrides"].pop(card_id, None)
        write_state(state)
        return True, "deleted"

    live = {c["id"]: c for c in collect()}.get(card_id)
    if live is None:
        state["overrides"].pop(card_id, None)
        write_state(state)
        return True, "deleted"
    if live["column"] == "working":
        return False, "session is still running"
    state["overrides"].setdefault(card_id, {})["column"] = "archived"
    write_state(state)
    return True, "moved to archived (the session's own history is kept)"


