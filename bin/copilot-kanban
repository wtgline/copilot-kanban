<script>
const COLDEF=[["backlog","Backlog"],["working","Working"],["available","Available"],
              ["archived","Archived"]];
let CARDS=[],WINDOWS=[],dragId=null,paused=false,current=null;

function toast(m){const t=document.getElementById('toast');t.textContent=m;
  t.classList.add('on');clearTimeout(t._x);t._x=setTimeout(()=>t.classList.remove('on'),2200);}

const KANBAN_TOKEN='__KANBAN_TOKEN__';

async function api(path,body){
  const o=body?{
    method:'POST',
    headers:{'Content-Type':'application/json','X-Kanban-Token':KANBAN_TOKEN},
    body:JSON.stringify(body)
  }:{};
  try{
    const r=await fetch(path,o);
    return await r.json();
  }catch(e){
    return {ok:false,msg:'server unreachable — is copilot-kanban still running?'};
  }
}

let SERVER_VER=null;

async function load(force){
  if(paused&&!force)return;
  const d=await api('/api/state');
  if(!d||!d.cards)return;
  // If the server restarted with new code, this tab's JS is stale — reload
  // it rather than rendering new data with an old renderer.
  if(d.version){
    if(SERVER_VER===null){ SERVER_VER=d.version; }
    else if(SERVER_VER!==d.version){ location.reload(); return; }
  }
  CARDS=d.cards;WINDOWS=d.windows;render();
}

function render(){
  const b=document.getElementById('board');
  b.innerHTML='';
  for(const [key,label] of COLDEF){
    const items=CARDS.filter(c=>c.column===key);
    const col=document.createElement('div');
    col.className='col c-'+key;col.dataset.col=key;
    col.innerHTML=`<h2>${label}<span class="n">${items.length}</span></h2>`;
    const body=document.createElement('div');body.className='body';
    if(!items.length){
      const e=document.createElement('div');e.className='empty';
      e.textContent = key==='backlog' ? 'Add a task, then drag it to Working'
                     : key==='available' ? 'Sessions ready for new work land here'
                     : 'Drop cards here';
      body.appendChild(e);
    }
    for(const c of items) body.appendChild(cardEl(c));
    col.appendChild(body);
    col.addEventListener('dragover',e=>{e.preventDefault();col.classList.add('over');});
    col.addEventListener('dragleave',()=>col.classList.remove('over'));
    col.addEventListener('drop',async e=>{
      e.preventDefault();col.classList.remove('over');
      if(!dragId)return;
      const src=CARDS.find(x=>x.id===dragId);
      if(src&&src.column===key)return;
      const r=await api('/api/move',{id:dragId,column:key});
      toast(r.ok?r.msg:('⚠ '+r.msg));
      dragId=null;paused=false;load(true);
    });
    b.appendChild(col);
  }
}

function cardEl(c){
  const d=document.createElement('div');
  d.className='card '+c.column+(c.recent?' recent-finish':'');d.draggable=true;
  const live=c.column==='working'?'<span class="pulse"></span>':'';
  const pane=c.pane?`<span class="badge pane">${c.pane}</span>`:'';
  const kind=c.kind==='task'?'<span class="badge">not started</span>':'';
  // Only ever render a plain text label. Guard against a stale tab that
  // still expects the old numeric field, which would otherwise print NaN.
  const fin=(typeof c.just_finished==='string')?c.just_finished:'';
  const finished=fin?`<span class="just-finished">✓ ${esc(fin)}</span>`:'';
  const quickJump=c.pane?`<div class="quick-jump" title="Jump to pane (no command sent)">↗</div>`:'';
  d.innerHTML=`${quickJump}<div class="t">${live}${esc(c.title)}</div>
    ${finished?`<div class="meta" style="margin-bottom:5px">${finished}</div>`:''}
    <div class="meta">${pane}${kind}<span class="badge">${esc(c.cwd||'')}</span>
    <span>${c.age||''}</span></div>`;
  d.addEventListener('dragstart',()=>{dragId=c.id;paused=true;d.classList.add('dragging');});
  d.addEventListener('dragend',()=>{d.classList.remove('dragging');paused=false;dragId=null;});
  d.addEventListener('click',()=>openCard(c));
  const qj=d.querySelector('.quick-jump');
  if(qj){
    qj.addEventListener('click',async e=>{
      e.stopPropagation();  // don't also open the card modal
      const r=await api('/api/focus',{id:c.id});
      toast(r.ok?r.msg:('⚠ '+r.msg));
    });
  }
  return d;
}

function esc(s){return (s||'').replace(/[&<>"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]));}

async function openCard(c){
  current=c;
  document.getElementById('dTitle').textContent=c.title;
  document.getElementById('dKv').innerHTML=
    `<span class="k">Status</span><span>${c.column}</span>
     <span class="k">Folder</span><span>${esc(c.cwd||'')}</span>
     <span class="k">tmux</span><span>${c.pane?esc(c.pane):'—'}</span>
     <span class="k">Session</span><span>${esc(c.short)}</span>
     <span class="k">Updated</span><span>${c.age||''} ago</span>`;
  document.getElementById('dPromptWrap').style.display=c.prompt?'block':'none';
  document.getElementById('dPrompt').textContent=c.prompt||'';
  document.getElementById('dJump').style.display=c.pane?'inline-block':'none';
  const aw=document.getElementById('dAssignWrap');
  aw.style.display=(c.pane && c.column!=='working')?'block':'none';
  document.getElementById('dAssignPrompt').value='';
  const ow=document.getElementById('dOutWrap');
  ow.style.display='none';
  document.getElementById('dOutFull').style.display='none';
  document.getElementById('dOutToggle').textContent='Show full output';
  document.getElementById('mCard').classList.add('on');paused=true;
  if(c.kind==='session'){
    const r=await api('/api/detail?id='+encodeURIComponent(c.id));
    if(r.summary || r.output_html){
      document.getElementById('dOut').textContent=r.summary||'';
      document.getElementById('dOutFull').innerHTML=r.output_html||'';
      ow.style.display='block';
    }
  }
}

function toggleFull(){
  const full=document.getElementById('dOutFull');
  const btn=document.getElementById('dOutToggle');
  const showing=full.style.display!=='none';
  full.style.display=showing?'none':'block';
  btn.textContent=showing?'Show full output':'Hide full output';
}

async function assignTask(){
  const p=document.getElementById('dAssignPrompt').value.trim();
  if(!p){toast('type a task first');return;}
  const id=current.id;
  const r=await api('/api/assign',{id:id,prompt:p});
  if(!r.ok){toast('⚠ '+r.msg);return;}
  toast(r.msg);
  // The button promises a jump, so actually perform one.
  await api('/api/focus',{id:id});
  closeAll();
  load(true);
}

async function jump(){
  const r=await api('/api/focus',{id:current.id});
  toast(r.ok?r.msg:('⚠ '+r.msg));
}
async function delCard(){
  const r=await api('/api/delete',{id:current.id});
  toast(r.ok?r.msg:('⚠ '+r.msg));
  if(r.ok){closeAll();load(true);}
}
function openNew(){
  const s=document.getElementById('nWin');
  s.innerHTML=WINDOWS.map(w=>`<option>${esc(w)}</option>`).join('')||'<option>(no tmux)</option>';
  document.getElementById('mNew').classList.add('on');paused=true;
  document.getElementById('nTitle').focus();
}
async function createTask(){
  const t=document.getElementById('nTitle').value.trim();
  if(!t){toast('title required');return;}
  await api('/api/new',{title:t,prompt:document.getElementById('nPrompt').value,
    dir:document.getElementById('nDir').value,window:document.getElementById('nWin').value});
  document.getElementById('nTitle').value='';document.getElementById('nPrompt').value='';
  closeAll();toast('task added to Backlog');load();
}
function closeAll(){document.querySelectorAll('.modal').forEach(m=>m.classList.remove('on'));paused=false;}
document.querySelectorAll('.modal').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)closeAll();}));
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeAll();});

load();setInterval(load,2000);
</script>
</body></html>
"""


class Handler(BaseHTTPRequestHandler):
    # Set by main() so request validation knows what a legitimate Host looks
    # like for this particular launch.
    bound_port = None

    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype="application/json"):
        data = body.encode("utf-8") if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        # Nothing here should ever be embedded in another page.
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(data)

    # ------------------------------------------------------------- guards
    def _host_ok(self):
        """Reject anything that didn't address us as localhost.

        We bind 127.0.0.1, but that alone does not stop DNS rebinding: a page
        on evil.com whose DNS is re-pointed at 127.0.0.1 would reach us with
        Host: evil.com and be treated as same-origin by the browser. Pinning
        the Host header closes that hole.
        """
        host = (self.headers.get("Host") or "").strip()
        if not host:
            return False
        allowed = set()
        for name in ("127.0.0.1", "localhost", "[::1]"):
            allowed.add(f"{name}:{self.bound_port}")
            allowed.add(name)
        return host in allowed

    def _origin_ok(self):
        """Cross-origin pages may not drive the board.

        Browsers always attach Origin to cross-origin POSTs, including the
        'simple' text/plain kind that skips a CORS preflight. Requiring it to
        be absent (curl, same-origin fetch) or to match us exactly blocks
        classic CSRF.
        """
        origin = self.headers.get("Origin")
        if not origin:
            return True
        return origin in (
            f"http://127.0.0.1:{self.bound_port}",
            f"http://localhost:{self.bound_port}",
            f"http://[::1]:{self.bound_port}",
        )

    def _token_ok(self):
        """Mutating requests must present the per-launch token.

        The token is embedded in the page we serve, so only a client that
        actually loaded the board over localhost can read it. This is the
        backstop that survives even if Host/Origin checks are bypassed.
        """
        return self.headers.get("X-Kanban-Token") == SESSION_TOKEN

    def _deny(self, msg):
        self._send(403, json.dumps({"ok": False, "msg": msg}))

    def do_GET(self):
        if not self._host_ok():
            return self._deny("bad host header")
        path = self.path.split("?")[0]
        if path == "/":
            page = PAGE.replace("__KANBAN_TOKEN__", SESSION_TOKEN)
            return self._send(200, page, "text/html; charset=utf-8")
        if path == "/api/state":
            return self._send(200, json.dumps(
                {"cards": collect(), "windows": tmux_windows(),
                 "version": SERVER_VERSION}))
        if path == "/api/detail":
            from urllib.parse import urlparse, parse_qs
            sid = (parse_qs(urlparse(self.path).query).get("id") or [""])[0]
            # The id becomes a path segment, so only ever accept the name of a
            # real session directory — never anything with separators in it.
            if not valid_session_id(sid):
                return self._send(200, json.dumps({"summary": "", "output_html": ""}))
            raw = last_assistant_text(sid, limit=4000)
            return self._send(200, json.dumps({
                "summary": summarize(raw),
                "output_html": markdown_to_html(raw),
            }))
        self._send(404, json.dumps({"ok": False, "msg": "not found"}))

    def do_POST(self):
        # These endpoints spawn processes and type into terminals, so they get
        # all three checks.
        if not self._host_ok():
            return self._deny("bad host header")
        if not self._origin_ok():
            return self._deny("cross-origin request rejected")
        if not self._token_ok():
            return self._deny("missing or invalid token — reload the board")
        try:
            n = int(self.headers.get("Content-Length") or 0)
            if n > 1_000_000:
                return self._send(413, json.dumps({"ok": False, "msg": "payload too large"}))
            payload = json.loads(self.rfile.read(n) or "{}")
            if not isinstance(payload, dict):
                payload = {}
        except Exception:
            payload = {}
        path = self.path.split("?")[0]
        try:
            if path == "/api/move":
                ok, msg = move(payload.get("id"), payload.get("column"))
            elif path == "/api/focus":
                ok, msg = focus(payload.get("id"))
            elif path == "/api/assign":
                ok, msg = assign(payload.get("id"), payload.get("prompt"))
            elif path == "/api/new":
                ok, msg = new_card(payload)
                msg = "created"
            elif path == "/api/delete":
                ok, msg = delete_card(payload.get("id"))
            else:
                ok, msg = False, "unknown endpoint"
        except Exception as e:
            ok, msg = False, f"{type(e).__name__}: {e}"
        self._send(200, json.dumps({"ok": ok, "msg": msg}))


USAGE = """copilot-kanban — Kanban board for GitHub Copilot CLI sessions (macOS)

Usage:
  copilot-kanban [options]

Options:
  --port PORT      Port to serve on (default 47900, or $COPILOT_KANBAN_PORT)
  --tmux NAME      tmux session to dispatch new agents into
                   (default: auto-detected, or $COPILOT_KANBAN_TMUX)
  --no-open        Don't open a browser window on start
  --version        Print version and exit
  -h, --help       Show this help
"""


def preflight():
    """Warn about missing prerequisites instead of failing mysteriously later."""
    problems = []
    if sys.platform != "darwin":
        problems.append(
            "! This tool currently supports macOS only. Notifications and "
            "'jump to pane' rely on AppleScript and will not work here.")
    if not os.path.isdir(ROOT):
        problems.append(
            f"! No Copilot CLI session data found at {ROOT}\n"
            "  Install GitHub Copilot CLI and run at least one session first.")
    if not tmux_available():
        problems.append(
            "! tmux is not running. The board will still load, but it cannot "
            "link cards to panes or dispatch new agents until tmux is up.")
    hooks = os.path.join(COPILOT_HOME, "hooks")
    if not glob.glob(os.path.join(hooks, "*.json")):
        problems.append(
            f"! No Copilot hooks installed in {hooks}\n"
            "  Without them the board cannot tell Working from Available.\n"
            "  Run ./install.sh from the repo to set them up.")
    for p in problems:
        print(p, file=sys.stderr)
    if problems:
        print("", file=sys.stderr)


def parse_port(raw, source):
    """Validate a port from either the env or the command line."""
    try:
        value = int(raw)
    except (TypeError, ValueError):
        print(f"error: {source} must be a number (got {raw!r})", file=sys.stderr)
        return None
    if not 1 <= value <= 65535:
        print(f"error: {source} must be between 1 and 65535 (got {value})",
              file=sys.stderr)
        return None
    return value


def main():
    argv = sys.argv[1:]
    if "-h" in argv or "--help" in argv:
        print(USAGE)
        return 0
    if "--version" in argv:
        print(f"copilot-kanban {__version__}")
        return 0

    port = DEFAULT_PORT
    env_port = os.environ.get("COPILOT_KANBAN_PORT")
    if env_port:
        port = parse_port(env_port, "COPILOT_KANBAN_PORT")
        if port is None:
            return 2
    if "--port" in argv:
        try:
            raw = argv[argv.index("--port") + 1]
        except IndexError:
            print("error: --port needs a number", file=sys.stderr)
            return 2
        port = parse_port(raw, "--port")
        if port is None:
            return 2
    if "--tmux" in argv:
        try:
            os.environ["COPILOT_KANBAN_TMUX"] = argv[argv.index("--tmux") + 1]
        except IndexError:
            print("error: --tmux needs a session name", file=sys.stderr)
            return 2

    preflight()

    url = f"http://127.0.0.1:{port}/"
    Handler.bound_port = port
    try:
        srv = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    except OSError as e:
        print(f"error: cannot bind {url} — {e}", file=sys.stderr)
        print("Another copy may already be running; try --port with a "
              "different number.", file=sys.stderr)
        return 1

    session = resolve_tmux_session()
    print(f"Copilot Kanban {__version__} → {url}")
    print(f"tmux session: {session or 'not detected (set --tmux to dispatch agents)'}")
    if AUTO_APPROVE:
        print("dispatched agents run with --yolo (tools auto-approved); "
              "set COPILOT_KANBAN_AUTO_APPROVE=0 to change")
    print("Ctrl-C to stop.")
    if "--no-open" not in argv:
        webbrowser.open(url)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
